# Additions to /srv/icos/etc/icos.env for AUTONOMY on the VPS (B1 + B2 + D). NO SECRET IN THIS FILE.
# Merge by hand (owner), keep a dated .bak of icos.env first, then restart icos-web AND
# icos-temporal-worker (both read this file). Verified read-only by deploy/vps/bin/icos-autonomy-check.sh.
#
# Measured on 2026-10-11 (release 5719213, /srv/icos/current): claude 2.1.292, bubblewrap 0.9.0,
# OmniRoute serves /v1/messages (the executor's path) for codex/gpt-5.5-low, codex/gpt-5.6-sol,
# cx/gpt-5.6-sol, nvidia/openrouter nemotron; NOT for cc/* and claude/* ("No active credentials for
# provider: claude"); auto/claude-sonnet is served by gemini-3.1-flash-lite (16 s). The lab proof
# (hello.txt, 9 937 tokens metered) ran on codex/gpt-5.5-low.

# ---------------------------------------------------------------- B1 — sovereign paths (no Mac path)
# The canonical checkout read-only tasks and the writer's base are bound to. /srv/icos/current is the
# release symlink: it follows every cutover and never points at a developer tree.
ICOS_REPO_PATH=/srv/icos/current
ICOS_WORKSPACE_ROOT=/srv/icos/current
# Governed worker worktrees (exists, 755 icos:icos, empty).
ICOS_WORKER_WORKSPACE_ROOT=/srv/icos/workers
# Runtime tier (ADR 0077). Declaring "live" NEVER creates a proof: a dimension is certified only
# when a durable row proves it in this runtime; with no proof the level stays L0 / CODE_READY.
ICOS_RUNTIME_TIER=live

# ---------------------------------------------------------------- B2 — governed execution (W10)
# The only executable the worker may launch, and how (bubblewrap, network unshared, metered
# UNIX-socket proxy to OmniRoute /v1/messages under the goal's budget). {{model}}/{{provider}} are
# substituted from the ROUTED worker; an unroutable command is refused before any call.
ICOS_WORKER_EXECUTABLE_ALLOWLIST=["/srv/icos/current/bin/icos-claude-worker.mjs"]
ICOS_WORKER_EXEC_COMMANDS={"binary":{"command":"/srv/icos/current/bin/icos-claude-worker.mjs","args":["--prompt","{{prompt}}","--model","{{model}}","--max-budget-usd","1.50","--timeout-ms","840000","--allow-bash","pnpm test*","--allow-bash","pnpm vitest run *","--allow-bash","pnpm exec eslint *"],"timeoutMs":900000}}
# Per-run wall clock of the activity (worker side).
ICOS_WORKER_EXECUTION_TIMEOUT_MS=900000

# Integration gate (W7): runs in the worker sandbox; the PostgreSQL step only ever sees a per-run
# disposable database created on the TEST cluster below, never the live base.
ICOS_GATE_COMMANDS={"install":["pnpm","install","--frozen-lockfile","--offline"],"typecheck":["pnpm","run","typecheck"],"lint":["pnpm","run","lint"],"unit":["pnpm","test"],"build":["node","-e",""],"postgres":[["pnpm","run","test:db:setup"]]}
# Admin URL of the TEST cluster for the gate (database name MUST contain "test": guard refuses
# anything else). Recommended: a dedicated container, see deploy/vps/README.md "Gate database".
# ICOS_TEST_DATABASE_URL=postgres://icos:<secret>@127.0.0.1:5434/icos_gate_test

# Independent review: an ICOS reviewer that is NOT the writer's model (the gate refuses same-model).
# REMOVE ICOS_REVIEWER_COMMAND (the /usr/bin/printf stub) when setting this: the model selects the
# OmniRoute reviewer. cx/gpt-5.6-sol issued the lab's REQUEST_CHANGES on 2026-10-11.
# Option B (owner, 2026-10-12): writer pool codex/gpt-5.6-sol, reviewer NVIDIA Nemotron 3 Ultra —
# different family (GPT_SOL vs NEMOTRON_550B), so the gate's same-judge refusal never fires.
ICOS_REVIEWER_MODEL=nvidia/nvidia/nemotron-3-ultra-550b-a55b
ICOS_REVIEWER_TIMEOUT_MS=120000
# Planner stays on the model already configured in icos.env (nvidia nemotron-3-ultra) unless the
# owner changes it; the lab used codex/gpt-5.5-low.
# ICOS_PLANNER_MODEL=codex/gpt-5.5-low

# Budgets. Tokens are the only enforceable unit while the price registry is empty (decision 0066);
# the --max-budget-usd above is the CLI's own second guard.
ICOS_GOAL_MAX_TOTAL_TOKENS=450000
ICOS_MAX_OUTPUT_TOKENS=8192
# Real caps for the first canary (attempts, cycles, duration). USD stays indicative (unpriced).
ICOS_AUTONOMY_MAX_CYCLES=6
ICOS_AUTONOMY_MAX_REPLANS=1
ICOS_AUTONOMY_MAX_STAGNATION_CYCLES=2
ICOS_AUTONOMY_MAX_RUNTIME_MS=3600000
ICOS_PLANNER_TIMEOUT_MS=120000

# Self-development detection (ADR 0076, W11). DISABLED until the canary mission (step E) is
# authorised: enabling it lets the scheduler propose and run one bounded goal per day on its own.
ICOS_SELF_DEVELOPMENT=disabled
ICOS_SELF_DEVELOPMENT_MAX_PROPOSALS_PER_DAY=1
ICOS_SELF_DEVELOPMENT_PROPOSAL_MAX_TOTAL_TOKENS=50000
ICOS_SELF_DEVELOPMENT_DETECTOR_PATHS=src
# Integration target of governed work: integration/<name> only, never main.
ICOS_INTEGRATION_TARGET=integration/autonomy-now-001

# Writer pool (mission model allowlist). The executor's {{model}} is the ROUTED worker's model, so
# the pool decides who writes; the gate refuses a reviewer of the same family (decision 0054,
# GPT_SOL / NEMOTRON_* / CLAUDE_* families). Pick ONE of the options in
# docs/icos/DEPLOYMENT_PLAN_NEXT_2026-10-12.md §2 and keep the reviewer out of that family:
#   option A: ICOS_AUTONOMY_ALLOWED_MODELS=nvidia/nvidia/nemotron-3-super-120b-a12b,nvidia/nvidia/nemotron-3-ultra-550b-a55b
#             ICOS_AUTONOMY_ALLOWED_PROVIDERS=nvidia            (reviewer cx/gpt-5.6-sol)
#   option B: ICOS_AUTONOMY_ALLOWED_MODELS=codex/gpt-5.6-sol
#             ICOS_AUTONOMY_ALLOWED_PROVIDERS=codex             (reviewer nvidia/nvidia/nemotron-3-ultra-550b-a55b)
ICOS_AUTONOMY_ALLOWED_MODELS=codex/gpt-5.6-sol
ICOS_AUTONOMY_ALLOWED_PROVIDERS=codex

# ---------------------------------------------------------------- D — Temporal isolation
# Create the namespace FIRST (owner, on the shared server), then set the SAME value here for
# icos-web (dispatcher) and icos-temporal-worker (poller) — both read this file:
#   docker exec icos-test-temporal sh -c 'temporal operator namespace create --address $(hostname -i):7233 --namespace icos-prod --retention 720h --description "ICOS production"'
TEMPORAL_NAMESPACE=icos-prod
TEMPORAL_TASK_QUEUE=icos-tasks
