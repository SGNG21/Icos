# Additions to /srv/icos/etc/icos.env for the FIRST autonomous mission on the VPS (AUTONOMY-NOW-001).
# NO SECRET IN THIS FILE. Merge by hand (owner) AFTER icos.env.sovereignty.example, keep a dated .bak.
# Values mirror the N1 lab (/home/icos/.icos-n1-lab/lab.env) with production paths; the lab is the
# only place where this configuration has run so far.
#
# Prerequisites: the deployed tree is the convergence release (hub d3edd8a + 449fda6 + voice),
# `bin/icos-claude-worker.mjs` exists in it, /usr/bin/claude is installed (2.1.292 measured),
# bwrap works (AppArmor profile /etc/apparmor.d/bwrap present).

# --- Executor: Claude Code via OmniRoute (W10). Paths point INTO the deployed release tree.
# <RELEASE> = the immutable release directory (not a git worktree, see audit R4).
ICOS_WORKER_EXECUTABLE_ALLOWLIST=["<RELEASE>/bin/icos-claude-worker.mjs"]
ICOS_WORKER_EXEC_COMMANDS={"binary":{"command":"<RELEASE>/bin/icos-claude-worker.mjs","args":["--prompt","{{prompt}}","--model","{{model}}","--max-budget-usd","1.50","--timeout-ms","840000","--allow-bash","pnpm test*","--allow-bash","pnpm vitest run *","--allow-bash","pnpm exec eslint *"],"timeoutMs":900000}}

# --- Gate (W7): runs in the worker sandbox, PostgreSQL step on a disposable database only.
ICOS_GATE_COMMANDS={"install":["pnpm","install","--frozen-lockfile","--offline"],"typecheck":["pnpm","run","typecheck"],"lint":["pnpm","run","lint"],"unit":["pnpm","test"],"build":["node","-e",""],"postgres":[["pnpm","run","test:db:setup"]]}
# The gate's postgres step needs a disposable server distinct from the live app database (5433).
# ICOS_TEST_DATABASE_URL=postgres://<user>:<secret>@127.0.0.1:<disposable-port>/icos_test

# --- Integration target: integration/<name> only (never main). One branch per canary.
ICOS_INTEGRATION_TARGET=integration/autonomy-now-001

# --- Independent review: a model that is NOT the worker's model.
# ICOS_REVIEWER_COMMAND (currently /usr/bin/printf in prod, audit R7) must be REMOVED when this is set.
ICOS_REVIEWER_MODEL=gemini/gemini-3.5-flash
ICOS_PLANNER_MODEL=codex/gpt-5.5-low

# --- Self-development detection (ADR 0076, W11): bounded.
ICOS_SELF_DEVELOPMENT=enabled
ICOS_SELF_DEVELOPMENT_MAX_PROPOSALS_PER_DAY=1
ICOS_SELF_DEVELOPMENT_PROPOSAL_MAX_TOTAL_TOKENS=50000
ICOS_SELF_DEVELOPMENT_DETECTOR_PATHS=src

# --- Budgets (tokens are the only enforceable unit while the price registry is empty).
ICOS_GOAL_MAX_TOTAL_TOKENS=450000
ICOS_MAX_OUTPUT_TOKENS=8192

# --- Temporal isolation from the integration suites (audit R3). Create it first:
#   docker exec icos-test-temporal sh -c 'temporal operator namespace create --address $(hostname -i):7233 --namespace icos-prod --retention 720h'
# then the SAME value for icos-web and icos-temporal-worker (both read this file), and restart both.
TEMPORAL_NAMESPACE=icos-prod
TEMPORAL_TASK_QUEUE=icos-tasks
