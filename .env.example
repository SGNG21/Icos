# Runtime
NODE_ENV=development

# Persistence backend selection (explicit, no silent fallback).
#   memory   -> in-memory backend (default in development/test)
#   postgres -> PostgreSQL backend (not yet implemented — Lot 2A-2)
# In production, PERSISTENCE must be set explicitly.
PERSISTENCE=memory

# Database (used only when PERSISTENCE=postgres, from Lot 2A-2 onward)
DATABASE_URL=

# Durable autonomous mission recovery (production PostgreSQL only).
# Positive integer milliseconds; defaults to 30000 when omitted.
AUTONOMY_RECOVERY_INTERVAL_MS=

# Durable Scheduler (ADR-0025): lease per claimed job, in milliseconds. Defaults to 120000.
SCHEDULER_LEASE_MS=

# Durable external worker dispatch through Temporal -> Hermes -> OmniRoute.
# Defaults: localhost:7233, hello-world, runIcosTask.
TEMPORAL_ADDRESS=
TEMPORAL_TASK_QUEUE=
TEMPORAL_WORKFLOW_TYPE=
# Positive integer milliseconds; defaults to 10000 when omitted.
TEMPORAL_DISPATCH_TIMEOUT_MS=

# Shared secret for authenticated Temporal worker callbacks to ICOS.
# Use a high-entropy value of at least 32 characters in real deployments.
ICOS_EXECUTION_CALLBACK_SECRET=

# Production autonomous planner through the configured OmniRoute endpoint.
# Planner activation requires ICOS_PLANNER_MODEL plus OmniRoute URL and key;
# partial planner-specific configuration fails closed.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
ICOS_PLANNER_MODEL=
# Positive integer milliseconds; defaults to 60000 when omitted.
ICOS_PLANNER_TIMEOUT_MS=
# Ask ICOS cognitive runtime (decision 0061): model used for conversation turns through
# OmniRoute. Unset (or no OmniRoute URL/key) => explicit NOT_CONNECTED engine.
ICOS_COGNITIVE_MODEL=
# Conversational workload routing (decision 0067 item 6): optional per-class overrides of
# ICOS_COGNITIVE_MODEL. A short text exchange routes to FAST, analysis/planning or long text
# to DEEP, a spoken turn to VOICE; an unset class falls back to ICOS_COGNITIVE_MODEL.
ICOS_COGNITIVE_MODEL_FAST=
ICOS_COGNITIVE_MODEL_DEEP=
ICOS_COGNITIVE_MODEL_VOICE=
# Conversation models (decision 0078 §3, 2026-10-14): ORDERED, comma-separated, concrete ids.
# Conversations fall back only to the next entry, on 429/5xx/timeout. A meta-route (auto/*,
# openrouter/auto, ...) refuses startup. Unset: CEO chat uses ICOS_CEO_MODEL/ICOS_REVIEWER_MODEL
# alone, else the measured free default; cognition has no fallback. See
# docs/icos/handoffs/conversation-routes-migration-2026-10-14.md.
ICOS_CONVERSATION_MODELS=

# Compute fleet bootstrap (live-worker bootstrap). OFF unless set to a truthy value.
# When on, every boot reconciles the worker registry with the models OmniRoute serves:
# idempotent, restart-safe (an unchanged candidate is NOT rewritten, so probe evidence
# survives a restart), and never a health claim — a candidate routes only once the
# durable probe_workers sweep gets a real answer from it. A provider outage is reported
# and never aborts startup. Off, the registry is written only by
# `pnpm compute:register --apply`; `pnpm compute:register` alone is a dry run.
ICOS_COMPUTE_BOOTSTRAP=
# Per-RUNTIME probe commands, as JSON, e.g.
#   {"binary":{"command":"...","args":["--model","{{model}}"],"healthyStdout":"..."}}
# WITHOUT this, a `binary` compute candidate has no probe adapter at all: it is recorded
# `unsupported`, stays unknown/unknown and routes nothing. Registering the fleet without
# it yields registered-but-unroutable workers.
ICOS_WORKER_PROBE_COMMANDS=
# Budget for ONE model health probe over OmniRoute's HTTP API. Default 15000 (measured
# against a LOCAL gateway; a remote one must be re-measured). A model worker is probed
# over HTTP whenever OMNIROUTE_BASE_URL/API_KEY are set — no shell, no agent, no host
# credentials. UNSET OmniRoute and a model worker has NO probe adapter at all: it is
# recorded `unsupported` and routes nothing, and it does NOT fall back to the command
# probe. That is enforced by the selector returning an explicit "nothing may probe this",
# not merely by the absence of a configured HTTP probe.
ICOS_WORKER_PROBE_HTTP_TIMEOUT_MS=

# Human authentication (Better Auth). Required when PERSISTENCE=postgres and auth
# is composed. BETTER_AUTH_SECRET must be a high-entropy value of >= 32 chars.
# Never commit real values — placeholders only.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Owner bootstrap (pnpm auth:bootstrap). ICOS_OWNER_PASSWORD is a TEMPORARY
# automation fallback; prefer the interactive masked prompt. Never a real value.
ICOS_OWNER_EMAIL=
ICOS_OWNER_PASSWORD=

# AI providers (disabled)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External integrations (disabled)
GITHUB_TOKEN=
N8N_BASE_URL=
N8N_API_KEY=
DOLIBARR_BASE_URL=
DOLIBARR_API_KEY=

# Voice (decision 0061) — served only by `pnpm voice:serve`. Models routed via OmniRoute.
# Unset = NOT_CONFIGURED (no voice sessions / text-only answers). Example values:
#   ICOS_VOICE_STT_MODEL=groq/whisper-large-v3-turbo
#   ICOS_VOICE_TTS_MODEL=gtts/fr
ICOS_VOICE_STT_MODEL=
ICOS_VOICE_TTS_MODEL=
# Fallback language for STT and TTS, used ONLY when the voice session states none
# (the browser normally sends navigator.language, which wins). 2-letter code.
# It must be sent: the gateway ignores the TTS model id and otherwise guesses the
# language from the text, so one English token flips a French reply to an English
# voice. Defaults to "fr". Other locales keep working through the session language.
ICOS_VOICE_LANGUAGE=
# Optional: the provider-specific VOICE id, sent to the gateway verbatim. Unset = the
# 2-letter language code above, which is all a backend with no voice concept can take.
# A voice is NOT a language, so this is the only way to reach a premium voice THROUGH THE
# GATEWAY (the direct adapters below take their own voice ids):
#   fishaudio/s1                  -> a Fish Audio reference_id  (premium target)
#   elevenlabs/eleven_multilingual_v2 -> an ElevenLabs voice id
#   edgetts/<voice>               -> fr-FR-RemyMultilingualNeural, fr-FR-HenriNeural
#   openai/gpt-4o-mini-tts        -> onyx, ash
# SET IT TOGETHER WITH ICOS_VOICE_TTS_MODEL. gTTS reads this field as a language and
# falls back to ENGLISH on anything it cannot parse, so a voice id against a gtts/*
# model makes a French answer read aloud in English. Measured, not theoretical.
ICOS_VOICE_TTS_VOICE=

# Premium TTS router (decision 0074). Every provider is opt-in; with none of these set, voice
# uses ICOS_VOICE_TTS_MODEL through OmniRoute exactly as before. Keys are SERVER-SIDE ONLY:
# never in browser code, logs or the WebSocket. Unset = NOT_CONFIGURED for that provider.
# Order (allowlist: fish, elevenlabs, edge, gtts). ICOS_VOICE_TTS_PROVIDER moves one to the head.
ICOS_TTS_PROVIDER_ORDER=
ICOS_VOICE_TTS_PROVIDER=
# true (default) | false = primary only.
ICOS_TTS_FALLBACK_ENABLED=
# Per attempt (default 15000) / to first audio byte on streaming providers (default 5000).
ICOS_TTS_TIMEOUT_MS=
ICOS_TTS_FIRST_AUDIO_TIMEOUT_MS=
# Optional tuning: retries on 5xx/network (default 1), circuit (3 failures, 30000 ms cooldown),
# chunking (min 40, first 20, max 220 characters).
ICOS_TTS_RETRIES=
ICOS_TTS_CIRCUIT_FAILURES=
ICOS_TTS_CIRCUIT_COOLDOWN_MS=
ICOS_TTS_CHUNK_MIN_CHARS=
ICOS_TTS_CHUNK_FIRST_MIN_CHARS=
ICOS_TTS_CHUNK_MAX_CHARS=
# Fish Audio (primary). Key + voice (reference_id) are both required.
# Also accepted: ICOS_VOICE_TTS_MODEL=fishaudio/<model> + ICOS_VOICE_TTS_VOICE=<reference_id>.
FISH_AUDIO_API_KEY=
ICOS_FISH_TTS_VOICE=
# Optional: model (default s1), format mp3|wav (default mp3), latency normal|balanced
# (default balanced), speed 0.5–2.
ICOS_FISH_TTS_MODEL=
ICOS_FISH_TTS_FORMAT=
ICOS_FISH_TTS_LATENCY=
ICOS_FISH_TTS_SPEED=
# ElevenLabs (premium fallback). Key + voice id are both required.
ELEVENLABS_API_KEY=
ICOS_ELEVENLABS_TTS_VOICE=
# Optional: model (default eleven_multilingual_v2), format mp3_* (default mp3_44100_128),
# voice settings 0–1 (stability, similarity, style), speed 0.7–1.2, speaker boost true|false,
# and LANGUAGE_CODE=true to send the session language (only some models accept it).
ICOS_ELEVENLABS_TTS_MODEL=
ICOS_ELEVENLABS_TTS_FORMAT=
ICOS_ELEVENLABS_TTS_STABILITY=
ICOS_ELEVENLABS_TTS_SIMILARITY=
ICOS_ELEVENLABS_TTS_STYLE=
ICOS_ELEVENLABS_TTS_SPEED=
ICOS_ELEVENLABS_TTS_SPEAKER_BOOST=
ICOS_ELEVENLABS_TTS_LANGUAGE_CODE=
# Free fallback through OmniRoute's edgetts provider, e.g. edgetts/fr-FR-HenriNeural.
# Optional voice field (unset = session language).
ICOS_EDGE_TTS_MODEL=
ICOS_EDGE_TTS_VOICE=
# Optional: serve HTTPS directly (PEM paths) — a phone needs a secure origin for the mic.
ICOS_VOICE_TLS_CERT=
ICOS_VOICE_TLS_KEY=
# Optional: the origin a phone uses through a TLS proxy (e.g. https://<machine>.<tailnet>.ts.net
# via `tailscale serve`). Set BETTER_AUTH_URL to the same origin.
# Use `tailscale serve` (tailnet only). NEVER `tailscale funnel`: Funnel publishes the same
# path to the public internet, which would put /login on the open web. Setting this variable
# exposes nothing by itself — it only tells Next which origin the browser uses.
ICOS_VOICE_PUBLIC_ORIGIN=

# ── Autonomy bounds and compute policy (all optional) ────────────────────────────
# Absent everywhere = exactly the previous behaviour. Each value may only NARROW the
# system ceiling (100 cycles / 3600000 ms / 5 replans / 3 stagnation cycles): a value
# ABOVE the ceiling makes the process REFUSE TO BOOT rather than be silently clamped,
# because nobody reads a clamp report at startup.
ICOS_AUTONOMY_MAX_CYCLES=
ICOS_AUTONOMY_MAX_RUNTIME_MS=
ICOS_AUTONOMY_MAX_REPLANS=
ICOS_AUTONOMY_MAX_STAGNATION_CYCLES=
# Comma-separated allowlists bounding which compute a mission may use. A goal policy may
# only REDUCE this set; asking for a model or provider outside it is REFUSED, never granted.
# Providers without models also refuses to boot (a provider-only policy is ambiguous).
# PRESENT-BUT-EMPTY REFUSES TO BOOT (an empty allowlist is ambiguous: "none" or a mistake?).
# Omit them entirely for "unrestricted"; uncomment with real ids to bound the pool.
#ICOS_AUTONOMY_ALLOWED_MODELS=model-a,model-b
#ICOS_AUTONOMY_ALLOWED_PROVIDERS=provider-a

# ── Budget (optional, but see the consequence) ───────────────────────────────────
# Per-goal TOKEN ceiling. With the price table empty (no invented tariffs), a token cap is
# the ONLY cap that can actually be satisfied, so this is the switch that lets an autonomous
# mission spend anything at all. ABSENT means a goal with no monetary budget is DENIED
# (NO_ENFORCEABLE_CAP) and a goal with a monetary budget is denied as soon as its window
# contains an unpriced call (UNPRICED_USAGE_IN_WINDOW). Fail-closed and deliberate: ICOS
# would rather spend nothing than claim a ceiling it cannot prove.
ICOS_GOAL_MAX_TOTAL_TOKENS=

# ── Governed self-improvement ("Améliore ICOS") ──────────────────────────────────
# Opt-in, and absent means OFF. Putting ICOS's own self-modification on a timer is the
# largest autonomy increase in the system, so it stays an explicit owner decision and is
# never acquired by deploying. An enum, not a boolean: a typo FAILS validation instead of
# silently meaning off. Runs on its own timer, never inside the shared recovery sweep.
ICOS_SELF_DEVELOPMENT=
