# Runtime
NODE_ENV=development

# Persistence backend selection (explicit, no silent fallback).
#   memory   -> in-memory backend (default in development/test)
#   postgres -> PostgreSQL backend (not yet implemented — Lot 2A-2)
# In production, PERSISTENCE must be set explicitly.
PERSISTENCE=memory

# Database (used only when PERSISTENCE=postgres, from Lot 2A-2 onward)
DATABASE_URL=

# Durable autonomous mission recovery (production PostgreSQL only).
# Positive integer milliseconds; defaults to 30000 when omitted.
AUTONOMY_RECOVERY_INTERVAL_MS=

# Durable Scheduler (ADR-0025): lease per claimed job, in milliseconds. Defaults to 120000.
SCHEDULER_LEASE_MS=

# Durable external worker dispatch through Temporal -> Hermes -> OmniRoute.
# Defaults: localhost:7233, hello-world, runIcosTask.
TEMPORAL_ADDRESS=
TEMPORAL_TASK_QUEUE=
TEMPORAL_WORKFLOW_TYPE=
# Positive integer milliseconds; defaults to 10000 when omitted.
TEMPORAL_DISPATCH_TIMEOUT_MS=

# Shared secret for authenticated Temporal worker callbacks to ICOS.
# Use a high-entropy value of at least 32 characters in real deployments.
ICOS_EXECUTION_CALLBACK_SECRET=

# Production autonomous planner through the configured OmniRoute endpoint.
# Planner activation requires ICOS_PLANNER_MODEL plus OmniRoute URL and key;
# partial planner-specific configuration fails closed.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
ICOS_PLANNER_MODEL=
# Positive integer milliseconds; defaults to 60000 when omitted.
ICOS_PLANNER_TIMEOUT_MS=
# Ask ICOS cognitive runtime (decision 0061): model used for conversation turns through
# OmniRoute. Unset (or no OmniRoute URL/key) => explicit NOT_CONNECTED engine.
ICOS_COGNITIVE_MODEL=

# Compute fleet bootstrap (live-worker bootstrap). OFF unless set to a truthy value.
# When on, every boot reconciles the worker registry with the models OmniRoute serves:
# idempotent, restart-safe (an unchanged candidate is NOT rewritten, so probe evidence
# survives a restart), and never a health claim — a candidate routes only once the
# durable probe_workers sweep gets a real answer from it. A provider outage is reported
# and never aborts startup. Off, the registry is written only by
# `pnpm compute:register --apply`; `pnpm compute:register` alone is a dry run.
ICOS_COMPUTE_BOOTSTRAP=
# Per-RUNTIME probe commands, as JSON, e.g.
#   {"binary":{"command":"...","args":["--model","{{model}}"],"healthyStdout":"..."}}
# WITHOUT this, a `binary` compute candidate has no probe adapter at all: it is recorded
# `unsupported`, stays unknown/unknown and routes nothing. Registering the fleet without
# it yields registered-but-unroutable workers.
ICOS_WORKER_PROBE_COMMANDS=

# Human authentication (Better Auth). Required when PERSISTENCE=postgres and auth
# is composed. BETTER_AUTH_SECRET must be a high-entropy value of >= 32 chars.
# Never commit real values — placeholders only.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Owner bootstrap (pnpm auth:bootstrap). ICOS_OWNER_PASSWORD is a TEMPORARY
# automation fallback; prefer the interactive masked prompt. Never a real value.
ICOS_OWNER_EMAIL=
ICOS_OWNER_PASSWORD=

# AI providers (disabled)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External integrations (disabled)
GITHUB_TOKEN=
N8N_BASE_URL=
N8N_API_KEY=
DOLIBARR_BASE_URL=
DOLIBARR_API_KEY=

# Voice (decision 0061) — served only by `pnpm voice:serve`. Models routed via OmniRoute.
# Unset = NOT_CONFIGURED (no voice sessions / text-only answers). Example values:
#   ICOS_VOICE_STT_MODEL=groq/whisper-large-v3-turbo
#   ICOS_VOICE_TTS_MODEL=gtts/fr
ICOS_VOICE_STT_MODEL=
ICOS_VOICE_TTS_MODEL=
# Optional: serve HTTPS directly (PEM paths) — a phone needs a secure origin for the mic.
ICOS_VOICE_TLS_CERT=
ICOS_VOICE_TLS_KEY=
# Optional: the origin a phone uses through a TLS proxy (e.g. https://<machine>.<tailnet>.ts.net
# via `tailscale serve`). Set BETTER_AUTH_URL to the same origin.
ICOS_VOICE_PUBLIC_ORIGIN=
