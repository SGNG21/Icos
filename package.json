{
  "name": "@holding-ia/icos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.10.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "NEXT_MANUAL_SIG_HANDLE=true next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "tsx scripts/test-db-setup.ts && vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:bootstrap": "tsx scripts/auth-bootstrap.ts",
    "auth:check": "tsx scripts/auth-check.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "test:db:setup": "tsx scripts/test-db-setup.ts",
    "db:verify-ledger": "tsx scripts/verify-migration-ledger.ts",
    "scheduler:enqueue": "tsx scripts/schedule-job.ts",
    "workspace:manager": "tsx scripts/workspace-manager.ts",
    "compute:snapshot": "tsx scripts/compute-snapshot.ts"
  },
  "dependencies": {
    "@temporalio/client": "^1.23.0",
    "@temporalio/common": "1.23.0",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.2.10",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "24.10.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.5",
    "typescript": "6.0.3",
    "uuid": "^14.0.2",
    "vitest": "4.1.10"
  }
}
